{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cors.py": {
      "runtime": "@vercel/python@3.10.4",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
